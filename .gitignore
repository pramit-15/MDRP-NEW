# =============================================================================
# Multi-Disease Risk Prediction (MDRP) - Git Ignore Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Byte-compiled / Python Cache
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.tmp
*.bak
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# 2. Virtual Environments
# -----------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# -----------------------------------------------------------------------------
# 3. Environment Variables, API Keys & Secrets (CRITICAL)
# -----------------------------------------------------------------------------
.env
.env.*
.env.local
.env*.local
!.env.example
*.pem
*.key
*.p12
*.pfx
*.pkcs12
*.crt
*.cert
*.id_rsa
*.id_ed25519
credentials.json
service_account.json
client_secret*.json

# -----------------------------------------------------------------------------
# 4. Databases, Local Storage & Persistence
# -----------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
mdrp_dev.db
*.db-journal
*.db-wal
*.db-shm

# -----------------------------------------------------------------------------
# 5. Testing & Code Coverage
# -----------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# -----------------------------------------------------------------------------
# 6. Logging & Diagnostics
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# 7. Frontend, Node.js & Next.js Build Artifacts
# -----------------------------------------------------------------------------
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
dist/
frontend/dist/
.turbo/
frontend/.turbo/
*.tsbuildinfo
next-env.d.ts
frontend/next-env.d.ts
.vercel/
frontend/.vercel/
test-results/
frontend/test-results/
playwright-report/
frontend/playwright-report/
blob-report/
frontend/blob-report/
.playwright/
frontend/.playwright/

# -----------------------------------------------------------------------------
# 8. IDE & Operating System Artifacts
# -----------------------------------------------------------------------------
.vscode/
frontend/.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# -----------------------------------------------------------------------------
# 9. Scratch, Local Dumps & Temp Artifacts
# -----------------------------------------------------------------------------
*project_structure*.txt
1project_structure*.txt
artifacts/
alembic_error.txt

# -----------------------------------------------------------------------------
# 10. Clinical Datasets (Privacy & Storage Optimization)
# -----------------------------------------------------------------------------
/data/raw/
/data/processed/
/data/*.csv
/data/**/*.csv
/data/**/*.parquet
/data/**/*.tsv
!/data/README.md
!/data/.gitkeep

# -----------------------------------------------------------------------------
# 11. Machine Learning Model Binaries & Weights (Root /models/)
# -----------------------------------------------------------------------------
/models/
*.pkl
*.pickle
*.joblib
*.h5
*.onnx
*.pt
*.pth

# Explicitly ensure backend SQLAlchemy database models are ALWAYS tracked
!backend/database/models/
!backend/database/models/**/*.py
!backend/database/models/*.py
backend/database/models/__pycache__/
